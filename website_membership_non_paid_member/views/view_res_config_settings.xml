<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']/.." position="before">
                <block title="Display Members Setting" id="website_membership_settings">
                    <setting
                        id="setting_website_display_waiting_membership"
                        string="Waiting Membership"
                        help="Display members if they have a draft membership invoice"
                    >
                        <field name="website_display_waiting_membership" />
                    </setting>
                    <setting
                        id="setting_website_display_invoiced_membership"
                        string="Invoiced Membership"
                        help="Display members if they have a confirmed membership invoice"
                    >
                        <field name="website_display_invoiced_membership" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
