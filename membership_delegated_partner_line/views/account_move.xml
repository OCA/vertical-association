<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_form_view" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field
                    name="delegated_member_id"
                    attrs="{'column_invisible':[('parent.is_membership_invoice', '!=', True)], 'invisible':[('is_membership', '!=', True)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
