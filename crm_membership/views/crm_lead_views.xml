<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">Show Membership data in Lead/Opportunity form view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="Membership"
                    name="membership"
                    invisible="membership_state in (False, 'none')"
                >
                    <group>
                        <field name="membership_state" />
                        <field name="membership_stop" invisible="1" />
                        <field
                            name="membership_start"
                            string="Membership period"
                            help="Membership period"
                            widget="daterange"
                            options="{
                                'end_date_field': 'membership_stop',
                            }"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter" model="ir.ui.view">
        <field
            name="name"
        >Add Membership filters in Lead/Opportunity search view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <search position="inside">
                <filter
                    string="Members"
                    name="all_members"
                    domain="[
                        ('membership_state', 'in', ['invoiced', 'paid', 'free']),
                    ]"
                    help="Membership is Invoiced/Paid/Free"
                />
                <filter
                    string="Start Date"
                    name="membership_start_date"
                    date="membership_start"
                />
                <filter
                    string="End Date"
                    name="membership_end_date"
                    date="membership_stop"
                />
            </search>
            <group position="inside">
                <filter
                    string="Membership State"
                    name="membership_state"
                    domain="[]"
                    context="{
                        'group_by': 'membership_state',
                    }"
                />
                <filter
                    string="Membership Start Date"
                    name="group_membership_start"
                    help="Starting Date Of Membership"
                    domain="[]"
                    context="{
                        'group_by': 'membership_start',
                    }"
                />
                <filter
                    string="Membership End Date"
                    name="group_membership_end"
                    help="Ending Date Of Membership"
                    domain="[]"
                    context="{
                        'group_by': 'membership_stop',
                    }"
                />
            </group>
        </field>
    </record>
</odoo>
